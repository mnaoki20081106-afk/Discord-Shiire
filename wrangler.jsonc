{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "discord-shiire",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "INVITE_GATEWAY",
        "class_name": "InviteGateway"
      }
    ]
  },
  "migrations": [
    {
      "tag": "invite-gateway-v1",
      "new_sqlite_classes": ["InviteGateway"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
